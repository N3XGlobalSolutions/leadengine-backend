# ============================================================================
# LeadEngine Backend — Environment Template
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# In production, inject these from AWS Secrets Manager / SSM, not a file.
# ============================================================================

# --- Environment ---
APP_ENV=development            # development | production  (prod is validated on boot)
DEBUG=true                     # MUST be false in production

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (comma-separated exact origins; no wildcards with credentials) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AWS ---
# Prefer an IAM role in production and OMIT these static keys entirely.
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=

# --- DynamoDB (REQUIRED in production — no test fallback) ---
DYNAMODB_TABLE_NAME=leadengine            # e.g. leadengine (prod) / test_leadengine (dev)

# --- Qdrant (vector DB) ---
QDRANT_URL=https://your-qdrant-host:6333  # use https in production
QDRANT_API_KEY=change-me
QDRANT_COLLECTION_NAME=leadengine_documents

# --- Redis (REQUIRED in production: rate limiting, cache, locks) ---
REDIS_URL=rediss://your-redis-host:6379   # use rediss:// (TLS) in production

# --- S3 / SQS (async ingestion) ---
AWS_S3_BUCKET_NAME=your-documents-bucket
AWS_SQS_QUEUE_URL=
OUTBOUND_SQS_QUEUE_URL=
USE_ASYNC_INGESTION=false

# --- Encryption (REQUIRED outside development; app fails fast if missing) ---
ENCRYPTION_KEY=generate-with-Fernet.generate_key

# --- WhatsApp / Meta webhook security (REQUIRED for inbound webhook) ---
WHATSAPP_VERIFY_TOKEN=your-meta-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret     # used for X-Hub-Signature-256 HMAC

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- LLM ---
# CLAUDE_API_KEY=

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,txt

# --- Chat security ---
CHAT_REQUIRE_KEY=true          # require a verified API/widget key on /api/chat

# --- Rate limits ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_INGEST=20/minute
